# Public app and Supabase browser configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase server-only administration
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Paddle Billing (use sandbox until launch verification passes)
PADDLE_ENVIRONMENT=sandbox
PADDLE_API_KEY=pdl_sdbx_apikey_replace_me
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=test_replace_me
PADDLE_WEBHOOK_SECRET=pdl_ntfset_replace_me
PADDLE_PRICE_ID=pri_replace_me

# Gemini server-only access
GEMINI_API_KEY=replace_me
GEMINI_MODEL=gemini-2.5-flash

# Rate-limit hashing (use a random 32+ byte value)
RATE_LIMIT_SALT=replace_with_a_random_value

# Optional redacted error reporting
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
