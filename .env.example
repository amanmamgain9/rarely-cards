# Public app and Supabase browser configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Optional Google Analytics 4 measurement ID (for example, G-XXXXXXXXXX).
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Supabase server-only administration
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Paddle Billing (use sandbox until launch verification passes)
PADDLE_ENVIRONMENT=sandbox
PADDLE_API_KEY=pdl_sdbx_apikey_replace_me
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=test_replace_me
PADDLE_WEBHOOK_SECRET=pdl_ntfset_replace_me
PADDLE_PRICE_ID=pri_replace_me
# Comma-separated old $5 card-pack prices; used only to honor issued transactions.
PADDLE_LEGACY_CARD_PRICE_IDS=

# Historical Lemon Squeezy webhook only; do not use for new checkouts. Keep
# configured until all previously issued checkout URLs and refunds are retired.
LEMON_SQUEEZY_STORE_ID=
LEMON_SQUEEZY_VARIANT_ID=
LEMON_SQUEEZY_WEBHOOK_SECRET=
LEMON_SQUEEZY_TEST_MODE=false

# Google Play Billing for the Android TWA
GOOGLE_PLAY_CHECKOUT_ENABLED=false
GOOGLE_PLAY_PACKAGE_ID=cards.rarely.app
NEXT_PUBLIC_GOOGLE_PLAY_PRODUCT_ID=three_talking_pet_videos
# Historical purchases stay verifiable/restorable but are not offered for sale.
GOOGLE_PLAY_LEGACY_CARD_PRODUCT_IDS=five_card_credits
# Full service-account JSON or its base64 encoding; never expose this publicly.
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
# Pub/Sub push OIDC values used by /api/webhooks/google-play.
GOOGLE_PLAY_PUBSUB_AUDIENCE=https://rarely.cards/api/webhooks/google-play
GOOGLE_PLAY_PUBSUB_SERVICE_ACCOUNT=google-play-rtdn@your-project.iam.gserviceaccount.com
# Comma-separated upload/debug and Play App Signing SHA-256 fingerprints.
ANDROID_ASSET_LINKS_SHA256_FINGERPRINTS=

# Optional Zazzle print checkout (disabled unless explicitly enabled)
ZAZZLE_PRINT_ENABLED=false
ZAZZLE_MEMBER_ID=123456789012345678
ZAZZLE_ASSOCIATE_ID=
ZAZZLE_TEMPLATE_ID=123456789012345678
ZAZZLE_IMAGE_PARAMETER=image1

# Gemini server-only access
GEMINI_API_KEY=replace_me
GEMINI_MODEL=gemini-3.6-flash

# Optional Seedance 2.0 pet-video generation through BytePlus ModelArk.
# When the API key is empty, video actions are hidden and routes return 503.
BYTEPLUS_ARK_API_KEY=
BYTEPLUS_WEBHOOK_SECRET=replace_with_a_random_value
BYTEPLUS_ARK_BASE_URL=https://ark.ap-southeast.bytepluses.com
SEEDANCE_MODEL=dreamina-seedance-2-0-260128
# Your contracted/model rate, used only to snapshot an internal cost estimate.
SEEDANCE_USD_PER_MILLION_TOKENS=

# Rate-limit hashing (use a random 32+ byte value)
RATE_LIMIT_SALT=replace_with_a_random_value

# Optional redacted error reporting
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
